   ],
   "source": [
    "min_price, p = map(float, input().split())\n",
    "prices = map(float, input().split())\n",
    "result = []\n",
    "for price in prices:\n",
    "    if price >= min_price:          \n",
    "        price = price * (1 - p / 100)\n",
    "    result.append(\"%.2f\" % price)\n",
    "print(\" \".join(result))"
   ]
