   "source": [
    "count = 0\n",
    "max_ = 0      \n",
    "done = False\n",
    "while not done:\n",
    "    for t in input().split():\n",
    "        h = int(t)\n",
    "        if h == 0:\n",
    "            done = True\n",
    "            break\n",
    "        if h > max_:   \n",
    "            count += 1\n",
    "            max_ = h\n",
    "print(count)"
   ]
